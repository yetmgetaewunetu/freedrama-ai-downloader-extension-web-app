{
  "name": "freedrama-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Authorized FreeDrama.ai episode inspector and streaming MP4 downloader (Web App + Chrome Extension)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:web": "npm run dev",
    "dev:extension": "npm --prefix extension run dev",
    "build": "npm run build:client && npm run build:server && npm run build:extension",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:extension": "npm --prefix extension run build",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm --prefix extension run typecheck"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7"
  }
}
