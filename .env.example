# Server configuration
PORT=3000

# Local directory where downloaded dramas/episodes will be saved
DOWNLOADS_DIR=./downloads

# Conservative batch download concurrency (1 or 2 recommended)
DOWNLOAD_CONCURRENCY=2

# Locale header sent to FreeDrama API
FREEDRAMA_LOCALE=en-US

# Optional: Developer-provided authorized session cookie header for entitled/VIP episodes
# Obtain from an authorized browser session; never commit real cookies or secrets.
# Example: FREEDRAMA_COOKIE="drama_visitor=...; drama_device=..."
FREEDRAMA_COOKIE=
