{
  "manifest_version": 3,
  "name": "FreeDrama.ai Video Downloader",
  "version": "1.0.0",
  "description": "Inspect FreeDrama.ai dramas and episodes and download authorized MP4 renditions using your Chrome session.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FreeDrama.ai Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://freedrama.ai/*",
        "https://www.freedrama.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://freedrama.ai/*",
    "https://www.freedrama.ai/*",
    "https://cdn.freedrama.ai/*"
  ]
}
